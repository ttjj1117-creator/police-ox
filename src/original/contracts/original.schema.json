            ]
          },
          "uniqueItems": true
        },
        "studyStatus": {
          "enum": [
            "pending",
            "confirmed"
          ]
        },
        "bookUnitIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "blueprintAreaCode": {
          "anyOf": [
            {
              "enum": [
                "CONST-THEORY",
                "CONST-RIGHTS",
                "CRIM-GENERAL",
                "CRIM-SPECIAL",
                "CRIM-INV",
                "CRIM-EVD",
                "POL-ADMIN-LAW",
                "POL-FOUNDATIONS",
                "POL-ADMIN-SCIENCE",
                "POL-ACTIVITIES",
                "POL-HISTORY"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "blueprintStatus": {
          "enum": [
            "pending",
            "confirmed"
          ]
        }
      },
      "required": [
        "studyUnitCode",
        "relatedStudyUnitCodes",
        "studyStatus",
        "bookUnitIds",
        "blueprintAreaCode",
        "blueprintStatus"
      ]
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(?:(?:lieut_)?(?:const|crim|police|crime|civil)_[0-9]{4}_[1-9][0-9]*_[1-9][0-9]*|demo_(?:const|crim|police)_[1-9][0-9]*)$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "gradingRevision": {
          "type": "integer",
          "minimum": 1
        },
        "subjectId": {
          "enum": [
            "constitution",
            "criminal",
            "police",
            "criminology",
            "civil_general"
          ]
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "body": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/block"
          },
          "minItems": 1
        },
        "choices": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "number": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4
              },
              "blocks": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/block"
                },
                "minItems": 1
              }
            },
            "required": [
              "number",
              "blocks"
            ]
          },
          "minItems": 4,
          "maxItems": 4
        },
        "officialAnswer": {
          "$ref": "#/$defs/officialAnswer"
        },
        "classification": {
          "anyOf": [
            {
              "$ref": "#/$defs/classification"
            },
            {
              "type": "null"
            }
          ]
        },
        "qa": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "textStatus": {
              "enum": [
                "pending",
                "checked",
                "hold"
              ]
            },
            "answerStatus": {
              "enum": [
                "pending",
                "checked",
                "hold"
              ]
            },
            "notes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "textStatus",
            "answerStatus",
            "notes"
          ]
        },
        "lifecycle": {
          "enum": [
            "active",
            "retired"
          ]
        }
      },
      "required": [
        "id",
        "revision",
        "gradingRevision",
        "subjectId",
        "source",
        "body",
        "choices",
        "officialAnswer",
        "classification",
        "qa",
        "lifecycle"
      ]
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "assetId": {
          "type": "string",
          "minLength": 1
        },
        "mimeType": {
          "enum": [
            "image/png",
            "image/jpeg"
          ]
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "base64": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9+/]*={0,2}$"
        }
      },
      "required": [
        "assetId",
        "mimeType",
        "sha256",
        "base64"
      ]
    }
  },
  "$comment": "구조 검사 기준이다. ID·과목·단원·자산·버전·상태의 추가 의미 검증은 02·07번 문서에 따라 별도로 수행한다. 구조 검사를 원문·공식 정답 대조로 취급하지 않는다."
}
